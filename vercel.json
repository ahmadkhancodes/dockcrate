{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/webhook-retries",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/rings-tick",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/device-count",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/catalog-sync",
      "schedule": "0 4 * * *"
    }
  ]
}
