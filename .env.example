# Copy to .env.local for dev. Never commit real values. Missing keys = stub mode.
APP_NAME=dockcrate
NEXT_PUBLIC_APP_URL=http://localhost:3000
# memory | mongo (defaults to mongo when MONGODB_URI is set)
DB_DRIVER=memory
MONGODB_URI=
MONGODB_DB=dockcrate
# >= 32 random chars, unique per app: openssl rand -base64 32
BETTER_AUTH_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# console | resend | smtp
MAIL_PROVIDER=console
RESEND_API_KEY=
MAIL_FROM=
CRON_SECRET=
ALTCHA_HMAC_KEY=
# JSON of remote flags, e.g. {"payments_enabled":"on"}
APP_FLAGS=
# comma separated founder admin emails
ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# M2: Entra (docs/MANUAL_STEPS.md 1, 3, 4). Unset = stub mode: fake Graph, email link sign in, no real tenants.
ENTRA_CLIENT_ID=
# Optional: only for sign in with a client secret instead of the certificate
ENTRA_CLIENT_SECRET=
ENTRA_CLIENT_CERT_THUMBPRINT=
ENTRA_CLIENT_CERT_PRIVATE_KEY_PEM=
# Ed25519 PKCS#8 PEM that signs package manifests (required outside the memory stub)
MANIFEST_SIGNING_KEY=
# true = a version without a passed VM check is held instead of publishing to Pilot only (D-01)
REQUIRE_VM_VERIFICATION=false
# real | fake (default: real when Entra is configured)
GRAPH_DRIVER=
